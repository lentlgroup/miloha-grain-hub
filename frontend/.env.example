# ─── Development ──────────────────────────────────────────────────────────────
# URL of the Laravel backend API server.
# The Vite dev server proxies /api/* requests to this target.
# Default: http://localhost:8000 (standard Laravel dev server)
VITE_BACKEND_URL=http://localhost:8000

# ─── Production (build-time) ──────────────────────────────────────────────────
# In production, the frontend is typically served by the same web server
# (e.g. nginx) that also reverse-proxies /api/* to the Laravel backend,
# so no VITE_BACKEND_URL is needed at build time — relative /api/* URLs work.
#
# If your frontend and backend are on different domains, set CORS_ALLOWED_ORIGINS
# in the backend .env and point the API calls to the absolute backend URL instead.
