>>>>>>> 56ecfe0cb53d889a935650869dbfcf6cc1768b52

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error          # Use 'debug' locally, 'error' in production

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=miloha_grain_hub
DB_USERNAME=root
DB_PASSWORD=

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Cache & Queue ────────────────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Mail ─────────────────────────────────────────────────────────────────────
# Use 'smtp' in production with your mail provider credentials.
MAIL_MAILER=log          # 'log' for dev, 'smtp' for production
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@milohapuregrains.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, or * for any origin.
# Example: https://www.milohapuregrains.co.tz,https://milohapuregrains.co.tz
CORS_ALLOWED_ORIGINS=*

# ─── Sanctum ──────────────────────────────────────────────────────────────────
# Set to the domain of your frontend in production so Sanctum accepts cookies.
# SANCTUM_STATEFUL_DOMAINS=milohapuregrains.co.tz

# ─── Redis (optional — only if you switch cache/queue to redis) ───────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── AWS S3 (optional — for file uploads) ────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
